# Code Rama on Apache / LiteSpeed (Hostinger). The site is a static export: one .html file per page.
Options -MultiViews -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /hub/ -> /hub, so every page has one address
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /hub -> hub.html, /simulator/play/case_01 -> simulator/play/case_01.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType model/stl .stl
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Pages always check for a new version, so an update shows up at once
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml model/stl
</IfModule>
